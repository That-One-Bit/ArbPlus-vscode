{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Arbplus",
	"patterns": [
		{"include": "#keywords"},
		{"include": "#strings"},
		{"include": "#comment"},
    {
      "name": "constant.numeric.arb",
      "match": "\\b[[:digit:]]+(\\.[[:digit:]]*)?"
    }
	],
	"repository": {
		"keywords": {
			"patterns": [{
        "name": "keyword.control.arb",
        "match": "<\\-"
      },
      {
        "name": "keyword.control.arb",
        "match": "\\->"
      },
      {
        "name": "keyword.control.arb",
        "match": "="
      }]
    },
		"strings": {
			"name": "string.quoted.double.arb",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.arb",
					"match": "\\\\(x[A-Fa-f0-9][A-Fa-f0-9]?|.)"
				}
			]
		},
    "comment": {
      "name": "comment.line.arb",
      "begin": "//",
      "end": "\n"
    }
	},
	"scopeName": "source.arbplus"
}
