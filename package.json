{
  "publisher": "ThatOneBit",
  "name": "ArbPlus",
  "displayName": "ArbPlus",
  "description": "Syntax highlighting for the ArbPlus programming language, based off of liamilan's crumb extension.",
  "version": "0.0.1",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/That-One-Bit/ArbPlus-vscode.git"
  },
  "contributes": {
    "languages": [{
      "id": "arbplus",
      "aliases": ["Arbplus", "arbplus", "ArbPlus"],
      "extensions": [".arbplus"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./assets/language-icon.png",
        "dark": "./assets/language-icon.png"
      }
    }],
    "grammars": [{
      "language": "arbplus",
      "scopeName": "source.arbplus",
      "path": "./syntaxes/arbplus.tmLanguage.json"
    }]
  }
}
